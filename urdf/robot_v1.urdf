      <topic>head_camera</topic>
      <camera>
        <horizontal_fov>1.91986</horizontal_fov>
        <image><width>960</width><height>600</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>20</far></clip>
        <depth_camera><clip><near>0.3</near><far>20</far></clip></depth_camera>
