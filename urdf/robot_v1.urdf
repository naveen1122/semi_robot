  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>
  <!-- trailing arm held at ride height (use robot_v1_suspension.urdf for the sprung version) -->
  <joint name="left_suspension_joint" type="fixed">
    <origin xyz="-0.12 0.206 0.025" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="left_suspension_link"/>
  </joint>
  <!-- ZLTECH ZLLG80ASM250-L hub motor, 200 mm tyre: 5.5 N.m rated / 16 N.m peak, 200 rpm (20.94 rad/s) -->
  <joint name="left_wheel_joint" type="continuous">
    <origin xyz="0.12 0.0441 -0.025" rpy="0 0 0"/>
    <parent link="left_suspension_link"/>
    <child link="left_wheel_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="16" velocity="20.94"/>
    <dynamics damping="0.02" friction="0.05"/>
  </joint>
  <!-- trailing arm held at ride height (use robot_v1_suspension.urdf for the sprung version) -->
  <joint name="right_suspension_joint" type="fixed">
    <origin xyz="-0.12 -0.206 0.025" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="right_suspension_link"/>
  </joint>
  <!-- ZLTECH ZLLG80ASM250-L hub motor, 200 mm tyre: 5.5 N.m rated / 16 N.m peak, 200 rpm (20.94 rad/s) -->
  <joint name="right_wheel_joint" type="continuous">
    <origin xyz="0.12 -0.0441 -0.025" rpy="0 0 0"/>
    <parent link="right_suspension_link"/>
    <child link="right_wheel_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="16" velocity="20.94"/>
    <dynamics damping="0.02" friction="0.05"/>
  </joint>
  <!-- Blickle LPA-PATH 75KF swivel caster: 75 x 25 wheel, 28 mm trail, passive -->
  <joint name="caster_fl_swivel_joint" type="continuous">
    <origin xyz="0.216 0.216 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="caster_fl_swivel_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="0" velocity="30"/>
    <dynamics damping="0.002" friction="0.01"/>
  </joint>
  <joint name="caster_fl_wheel_joint" type="continuous">
    <origin xyz="-0.028 0 -0.0625" rpy="0 0 0"/>
    <parent link="caster_fl_swivel_link"/>
    <child link="caster_fl_wheel_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="0" velocity="60"/>
    <dynamics damping="0.001" friction="0.005"/>
  </joint>
  <joint name="caster_fr_swivel_joint" type="continuous">
    <origin xyz="0.216 -0.216 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="caster_fr_swivel_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="0" velocity="30"/>
    <dynamics damping="0.002" friction="0.01"/>
  </joint>
  <joint name="caster_fr_wheel_joint" type="continuous">
    <origin xyz="-0.028 0 -0.0625" rpy="0 0 0"/>
    <parent link="caster_fr_swivel_link"/>
    <child link="caster_fr_wheel_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="0" velocity="60"/>
    <dynamics damping="0.001" friction="0.005"/>
  </joint>
  <joint name="caster_rl_swivel_joint" type="continuous">
    <origin xyz="-0.216 0.216 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="caster_rl_swivel_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="0" velocity="30"/>
    <dynamics damping="0.002" friction="0.01"/>
  </joint>
  <joint name="caster_rl_wheel_joint" type="continuous">
    <origin xyz="0.028 0 -0.0625" rpy="0 0 0"/>
    <parent link="caster_rl_swivel_link"/>
    <child link="caster_rl_wheel_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="0" velocity="60"/>
    <dynamics damping="0.001" friction="0.005"/>
  </joint>
  <joint name="caster_rr_swivel_joint" type="continuous">
    <origin xyz="-0.216 -0.216 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="caster_rr_swivel_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="0" velocity="30"/>
    <dynamics damping="0.002" friction="0.01"/>
  </joint>
  <joint name="caster_rr_wheel_joint" type="continuous">
    <origin xyz="0.028 0 -0.0625" rpy="0 0 0"/>
    <parent link="caster_rr_swivel_link"/>
    <child link="caster_rr_wheel_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="0" velocity="60"/>
    <dynamics damping="0.001" friction="0.005"/>
  </joint>
  <!-- TiMOTION TL4 3-stage lifting column: 650 mm stroke, 600 N push, 25-39 mm/s under load (55 mm/s no load), self-locking -->
  <joint name="lift_joint" type="prismatic">
    <origin xyz="-0.03 0 0.66" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="torso_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.65" effort="600" velocity="0.039"/>
    <dynamics damping="500" friction="50"/>
  </joint>
  <!-- middle tube of the column moves half the stroke -->
  <joint name="lift_stage2_joint" type="prismatic">
    <origin xyz="-0.03 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lift_stage2_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.325" effort="600" velocity="0.0195"/>
    <mimic joint="lift_joint" multiplier="0.5" offset="0"/>
  </joint>
  <!-- top head camera (ZED X, fixed, 10 deg down) -->
  <joint name="head_camera_joint" type="fixed">
    <origin xyz="0.158 0 0.701" rpy="0 0.174533 0"/>
    <parent link="torso_link"/>
    <child link="head_camera_link"/>
  </joint>
  <!-- pan-tilt for the second head camera: placed here provisionally until it is drawn in CAD -->
  <joint name="head_pantilt_bracket_joint" type="fixed">
    <origin xyz="0.19 0 0.58" rpy="0 0 0"/>
    <parent link="torso_link"/>
    <child link="head_pantilt_bracket_link"/>
  </joint>
  <!-- DYNAMIXEL XM430-W350-T at 12 V: 4.1 N.m stall, 46 rpm -->
  <joint name="head_pan_joint" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="head_pantilt_bracket_link"/>
    <child link="head_pan_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="4.1" velocity="4.8"/>
